{
  "name": "waygate-qoder",
  "version": "0.1.4",
  "description": "Qoder CN 本地反代：读取本机客户端登录态，提供 Anthropic/OpenAI 兼容的本地聊天端点",
  "keywords": [
    "qoder",
    "qoder2api",
    "reverse-proxy",
    "openai-compatible",
    "anthropic",
    "claude-code",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghaojie513/waygate-qoder.git"
  },
  "homepage": "https://github.com/zhanghaojie513/waygate-qoder#readme",
  "bugs": {
    "url": "https://github.com/zhanghaojie513/waygate-qoder/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qoc": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "waygate-core": "^0.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
